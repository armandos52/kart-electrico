# Configuración local de Obsidian y archivos del sistema
.obsidian/
.trash/
.DS_Store
Thumbs.db
desktop.ini

# Credenciales y configuración privada
.env
.env.*
!.env.example
*.pem
*.key
/07_DESARROLLO/respaldos/nucleo_f411/**/MBED.HTM

# Herramientas descargadas y compilaciones del banco Nucleo (procedencia en evidencia).
/07_DESARROLLO/herramientas/openocd/
/07_DESARROLLO/firmware/nucleo_f411_banco/.build/

# Archivos temporales
~$*
*.tmp
*.bak
__pycache__/
.venv/
node_modules/
.publicacion-local/

# Índices regenerables; conservar solo la carpeta
/08_INDICE_GENERADO/*
!/08_INDICE_GENERADO/.gitkeep

# Imágenes de flash extraídas: locales (repo público). Se versionan logs, hashes y documentación.
/07_DESARROLLO/respaldos/**/*.bin
/07_DESARROLLO/respaldos/**/*.elf
/07_DESARROLLO/respaldos/**/*.hex

# Borradores vacíos y archivo binario sin extensión: conservar solo localmente.
/Sin título*.canvas
/programa kart
# Duplicado de la propuesta; la copia canónica está en 07_DESARROLLO/propuesta_2026-27/.
/Proposta_Smart_Electric_Kart_V2_2026-27.docx

# Compilación PlatformIO
.pio/

# Recepción local; preparar por separado la publicación de originales grandes.
/02_ORIGINALES/entrega_2026-09-28/

# Originales fotográficos locales; vistas del kart seleccionadas para revisión pública.
/02_ORIGINALES/fotos_kart_2026-10-08/
/07_DESARROLLO/panel_local/static/referencias/*.jpg
!/07_DESARROLLO/panel_local/static/referencias/lateral.jpg
!/07_DESARROLLO/panel_local/static/referencias/trasera.jpg
!/07_DESARROLLO/panel_local/static/referencias/superior.jpg
# Volcados RGB565 del framebuffer F746 (ENS-0019): locales; PNG equivalentes y SHA-256 versionados.
/06_TRABAJO/evidencias/frontal_f746_2026-10-15/**/*.raw

# Configuración local del asistente; sin contenido del proyecto.
/.claude/

# Evidencias: conservar fuentes, imágenes, logs y hashes; derivados binarios locales.
/06_TRABAJO/evidencias/**/*.bin
/06_TRABAJO/evidencias/**/*.raw
/06_TRABAJO/evidencias/**/*.elf
/06_TRABAJO/evidencias/**/*.hex
